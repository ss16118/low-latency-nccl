+    //   printf("[Rank %d] i: %d, blockIdx.x: %d, blockIdx.y: %d, threadIdx.x: %d, maxthread: %d, perranklines: %d, last_cta_nthreads: %d\n", myrank, i, blockIdx.x, blockIdx.y, threadIdx.x, maxthread, perranklines, last_cta_nthreads);
