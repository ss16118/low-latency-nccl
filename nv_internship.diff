+
+NCCL_DEVICE_INLINE void ncclLLBufferStoreMultimem128(void* ptr, uint4 val) {
+  asm volatile("multimem.st.global.v4.f32 [%0], {%1,%2,%3,%4};"
+    :: "l"(ptr), "r"(val.x), "r"(val.y), "r"(val.z), "r"(val.w) : "memory");
+}
